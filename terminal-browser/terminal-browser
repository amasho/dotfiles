#!/bin/sh
# terminal-browser の入口 (~/.local/bin/terminal-browser からリンクする)
# 画面のない Linux では、WebGL を使えるように Electron を差し替える
# (Chromium の GPU プロセスが X の画面を開こうとして失敗し、WebGL が使えないため)
#
# 差し替えが効くのは terminal-browser の本体 (1 つのプロセス) を起動し直したあと

electron="$(dirname "$(readlink -f "$0")")/electron"

use_electron_wrapper() {
  [ "$(uname -s)" = Linux ] || return 1
  [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 1
  # AppArmor が user namespace を制限しているときは、electron のパスの許可がないと起動できない
  if [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ]; then
    slug="$(printf '%s' "$electron" | sha256sum | cut -c1-12)"
    if ! grep -qsF "$electron" "/etc/apparmor.d/terminal-browser-$slug"; then
      echo "terminal-browser: WebGL 用の AppArmor の許可がないため、そのまま起動します (dotfiles の install.sh を sudo ありで実行してください)" >&2
      return 1
    fi
  fi
}

if use_electron_wrapper; then
  PIXEL_ELECTRON_APP="$electron"
  export PIXEL_ELECTRON_APP
fi
exec "$HOME/.local/share/terminal-browser/app/bin/terminal-browser" "$@"
